# MongoDB
MONGODB_URI=mongodb://localhost:27017/social-auto-bot

# Google Gemini (caption + image generation)
GEMINI_API_KEY=your_gemini_api_key

# Facebook Page (manual fallback)
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_TOKEN=your_facebook_page_access_token

# Meta Facebook Login (connect Pages from dashboard)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

# X (Twitter) - optional
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# Optional: protect cron HTTP endpoint
CRON_SECRET=your_random_secret

# Server port (production)
PORT=8080
