{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|_next/|favicon.ico|.*\\..*).*)",
      "destination": "/"
    }
  ]
}
